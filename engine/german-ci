#!/usr/bin/env bash
# Wrapper so the tool runs from anywhere without activating the venv.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -x "$HERE/.venv/bin/python" ]; then
  PYTHON="$HERE/.venv/bin/python"
else
  PYTHON="$(command -v python3)"
fi

# Deliberately does NOT cd into the engine directory: you run this from
# wherever your subtitles are, and cd-ing would break every relative path you
# type. PYTHONPATH makes the package importable from anywhere instead, and the
# engine's own data paths are all absolute.
exec env PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON" -m german_ci "$@"
